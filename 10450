                nMonthIndex["jan"] = 1
                nMonthIndex["feb"] = 2
                nMonthIndex["mar"] = 3
                nMonthIndex["apr"] = 4
                nMonthIndex["may"] = 5
                nMonthIndex["jun"] = 6
                nMonthIndex["jul"] = 7
                nMonthIndex["aug"] = 8
                nMonthIndex["sep"] = 9
                nMonthIndex["oct"] = 10
                nMonthIndex["nov"] = 11
                nMonthIndex["dec"] = 12
                
                var nDaysInMonth = new Array(0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)

                for (i = 0; i < n; i++)
                {
                    switch (i)
                    {
                        case 0:
                            sSubPart = RegExp.$1
                            break
                        case 1:
                            sSubPart = RegExp.$2
                            break
                        case 2:
                            sSubPart = RegExp.$3
                            break
                    }
                
                    switch (sMatches[i])
                    {
                        case "d":
                        case "dd":
                            try
                            {
                                nDay = Number(sSubPart)
                            }
                            catch(e)
                            {
                                alert("Not a valid day in TODATE.")
								return false;
                            }
                            if (nDay == null)
							{
                                alert("Not a valid day in TODATE.")
								return false;
								}
                            break
                        case "m":
                        case "mm":
                        case "mmm":
                            try
                            {
                                if (sMatches[i] == "mmm")
                                    nMonth = nMonthIndex[sSubPart.toLowerCase()]
                                else
                                    nMonth = Number(sSubPart)
                            }
                            catch(e)
                            {
                                alert("Not a valid month in TODATE.")
								return false;
                            }
                            if (nMonth == null)
                                alert("Not a valid month.")
                            if (nMonth >= 1 && nMonth <= 12)
                                ;//ok
                            else
							{
                                alert("Not a valid month in TODATE.")
								return false;
								}
                            break
                        case "yy":
                        case "yyyy":
                            try
                            {
                                nYear = Number(sSubPart)
                            }
                            catch(e)
                            {
                                alert("Not a valid year in TODATE.")
								return false;
                            }
                            if (nYear == null)
							{
                                alert("Not a valid year in TODATE.")
								return false; 
							}
                            if (nYear >= 0 && nYear <= 99)
                            {
                                var nCenturyYear = (new Date()).getFullYear()
                                nCenturyYear = nCenturyYear - nCenturyYear % 100
                                if (nYear > 50)
                                    nYear += (nCenturyYear - 100)
                                else
                                    nYear += nCenturyYear
                            }

                            if (nYear >= 1000 && nYear <= 9999)
                                ;//ok
                            else
							{
                                alert("Not a valid year in TODATE.")
								return false;
								}
                            break
                        default:
                            alert("Unrecognized date format in TODATE.")
							return false;
                            break
                    }
                }

                var nTempYear
                var nTempMonth
                var bLeapYear

                if (nYear == null)
                    nTempYear = (new Date()).getFullYear()
                else
                    nTempYear = nYear

                if (nMonth == null)
                    nTempMonth = (new Date()).getMonth() + 1
                else
                    nTempMonth = nMonth

                if (nTempYear % 400 == 0)
