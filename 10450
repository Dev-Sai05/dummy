		   varData = varData.substring(0,2) + "/" + varData.substring(2,4) + "/" +  varData.substring(4,varData.length)
		      
		      }
		    
		    else
			{
		     alert("Please enter a valid TODATE");
			 return false;
            }
           }
		   }
        

       
        if (Number(varData.slice(0,3)))
        {
            sDisplayFormat = "yyyy/mm/dd"
            sDisplayFormat = ExpandFormat(sDisplayFormat)
        }
        else            
            sDisplayFormat = "dd/mm/yyyy"

        var varRawData = varData.replace(/[ \/\-\.\,]/g, "")
        if (varRawData.replace(/00/g, "") == "")
            return varRawData
        else
        if (varRawData.replace(/99/g, "") == "")
            return varRawData

        if (varData.length > sDisplayFormat.length)
		{
            alert("The length of data : " + varData + " you entered is greater than that allowed.")
			return false;
			}
        else
        {
            //parse the display format
            var sChar
            var nPos = 0

            var sMatches = new Array(3)
            var n = 0

            var sRegExp
            var oRegExp

            for (i = 0; i < sDisplayFormat.length; i++)
            {
                sChar = sDisplayFormat.substr(i, 1)
                switch (sChar)
                {
                    case "/":
                        sMatches[n] = sDisplayFormat.substring(nPos, i)
                        nPos = i + 1
                        n++
                        break
                }
            }
            
            sMatches[n] = sDisplayFormat.substring(nPos, i)
            n++
            
            sRegExp = "^"
            for (i = 0; i < n; i++)
            {
                sRegExp = sRegExp + "([A-Za-z0-9]+)"
                if (i == n - 1)
                    sRegExp = sRegExp + "$"
                else
                    sRegExp = sRegExp + "[ \\/\\-\\.\\,]"
            }
            
            oRegExp = new RegExp(sRegExp, "")
            
            if (varData.search(oRegExp) == -1)
