       IDENTIFICATION DIVISION.
       PROGRAM-ID. SSR940MS.
      ******************************************************************
      * PROGRAM:- SSR940MS (VISUAL COBOL MICROSERVICE MODULE)          *
      * PURPOSE:- GENERATE SWIFT MT940 STATEMENT FOR A SINGLE ACCOUNT  *
      *           WITHOUT BATCH SEQUENTIAL FILES OR DDL LOCKS.         *
      ******************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.
           CONSOLE IS CONS.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.

           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  WS-ACT-NO                            PIC X(16).
       01  WS-ACT-NO-CHK-DGT                    PIC X(17).
       01  WS-FD-CODE                           PIC X(05).
       01  WS-CURR                              PIC X(03).
       01  WA-DATE                              PIC 9(09) BINARY.
       01  DEAL-DT                              PIC X(09).
       01  WA-SR-NO                             PIC X(09).
       01  WA-DEAL-DATE                         PIC X(08).
       01  WA-BRANCH                            PIC X(05).
       01  WA-BR-REF                            PIC X(16).
       01  WA-JRNL                              PIC 9(09).
       01  WA-VAL-DATE                          PIC X(08).
       01  WA-VALUE-DATE REDEFINES WA-VAL-DATE.
           03 WA-VAL-DD                         PIC 9(02).
           03 WA-VAL-MM                         PIC 9(02).
           03 WA-VAL-CC                         PIC 9(02).
           03 WA-VAL-YY                         PIC 9(02).
       01  WA-AMT1                              PIC S9(14)V999
                                                SIGN TRAILING SEPARATE.
       01  WA-BAL                               PIC S9(14)V999
                                                SIGN TRAILING SEPARATE.
       01  WA-OPEN-BAL                          PIC S9(14)V999
                                                SIGN TRAILING SEPARATE.
       01  WA-OPEN-BAL-TEM                      PIC S9(14)V999
                                                SIGN TRAILING SEPARATE.
       01  WA-BIT                               PIC 9.
       01  WA-CORR-REF                          PIC X(16).
       01  WA-TRAN-CODE                         PIC 9(05).
       01  WG-NARR                              PIC X(30).
       01  WA-TRAN-NO                           PIC X(09).
       01  WA-BIC-CODE                          PIC X(12).
       01  SQ-GLDM-KEY                          PIC X(19).
       01  WA-NARR-REF                          PIC X(16).
       01  WS-BGL-BALANCE                       PIC S9(17)V9(3).
           EXEC SQL END DECLARE SECTION END-EXEC.

       01  WS-GLDM-KEY.
           03 WS-INST-NO                        PIC X(03).
           03 WA-GLDM-ACT-NO                    PIC X(16).

       01  WA-REC0                              PIC X(55).
       01  WA-REC1                              PIC X(13).
       01  WA-REC2                              PIC X(21).
       01  WA-REC3                              PIC X(16).
       01  WA-REC4.
           03 WA-R4                             PIC X(15).
           03 WA-OPENING-BAL04                  PIC X(18).
       01  WA-REC5                              PIC X(71).
       01  WA-R5                                PIC X(15).
       01  WA-TRAN-AMT.
           03 WA-AMT-PART1                      PIC 9(14) VALUE ZEROS.
           03 WA-AMT-PART1-RE REDEFINES WA-AMT-PART1.
              05 WA-NO OCCURS 14 TIMES          PIC 9.
           03 WA-AMT-PART2                      PIC X VALUE ",".
           03 WA-AMT-PART3                      PIC 9(03) VALUE ZEROS.
           03 WA-AMT-PART3-RE REDEFINES WA-AMT-PART3.
              05 WB-NO OCCURS 3 TIMES           PIC 9.
       01  WA-NTRF                              PIC X(04) VALUE 'NTRF'.
       01  WA-PART-BR-REF                       PIC X(16).
       01  WA-PART-CORR-REF                     PIC X(16).
       01  WA-MFX-SR-NO                         PIC X(09).
       01  WA-REC6.
           03 WA-R6                             PIC X(15).
           03 WA-CLOS-AMNT6                     PIC X(18).

       01  FLAG-62                              PIC 9.
       01  WA-CLOS-AMNT                         PIC S9(14)V999.
       01  WA-CLOS-AMNT1                        PIC X(17).
       01  WA-CLOS-AMNT2.
           03 WC-PART1                          PIC Z(13)9.
           03 WC-PART2                          PIC X VALUE ','.
           03 WC-PART3.
              05 WC-PART3A                      PIC X(02).
              05 WC-PART3B                      PIC X.

       01  WA-INDEX                             PIC 9(02) VALUE ZEROS.
       01  FLAG1                                PIC 9.
       01  WA-MESSAGE-END                       PIC X(03) VALUE "-}$".

       01  WC-SIGN                              PIC X.
       01  WC-IND                               PIC X(01).
       01  WE-C                                 PIC 9(04).
       01  WE-D                                 PIC 9(04).
       01  WE-A                                 PIC 9(04).
       01  WE-B                                 PIC 9(04).

       01  WA-REC8.
           03 WA-R8-86                          PIC X(04) VALUE ":86:".
           03 WA-R8-TRAN-CODE                   PIC X(06).
           03 WA-FILL1                          PIC X(01) VALUE ":".
           03 WA-R8-DESC-TEMP                   PIC X(15).
       01  WS-TALLY                             PIC 9(02) VALUE ZERO.
       01  WS-DESC-LENGTH                       PIC 9(02) VALUE ZERO.
       01  EXIT-TRAN                            PIC 9.
       01  WA-CO                                PIC 9(02).
       01  WB-CO                                PIC 9(02).
       01  P-IND                                PIC X(01).
       01  WA-I                                 PIC 9(04).

       01  WA-IND                               PIC X(01).
       01  WA-SIGN                              PIC X(01).
       01  WA-FLAG                              PIC X(01).
       01  WS-TEMP-BALANCE.
           03 WS-T1                             PIC Z(14).
           03 WS-T2                             PIC X VALUE ",".
           03 WS-T3.
              05 WS-T3-A                        PIC X(02).
              05 WS-T3-B                        PIC X.
       01  WA-S                                 PIC 9(04).
       01  WA-W                                 PIC 9(04).
       01  WW-B                                 PIC 9(04).
       01  WA-PREV-ACT-NO                       PIC X(16).

       01  WA-TRAN-DATE1.
           03 WA-TRAN-DD                        PIC 9(02).
           03 WA-TRAN-MM                        PIC 9(02).
           03 WA-TRAN-CC                        PIC 9(02).
           03 WA-TRAN-YY                        PIC 9(02).

       01  WA-TEMP-BAL-Z                        PIC Z(18).
       01  WA-TEMP-BAL REDEFINES WA-TEMP-BAL-Z.
           03 WA-TEMP-BAL-X                     PIC X(18).
       01  WA-TEMP-AMNT                         PIC S9(14)V999.
       01  WA-TRAN-AMOUNT                       PIC 9(14)V999.

       01  WB-SIGN                              PIC X(01).
       01  WB-IND                               PIC X(01).
       01  WA-STMNT-NO                          PIC 9(05).

       01  WS-EOF                               PIC X.
       01  WA-NM-FLG                            PIC X(01) VALUE "Y".

       01  UT0220-PARAM-AREA.
           COPY INSPARM     IN LIBRYMIS.
           COPY UT1999CA    IN LIBRYMIS.
           COPY UT0030CA    IN LIBRYMIS.
           COPY UT0020CA    IN LIBRYMIS.
           COPY DBIOCALL    IN LIBRYMIS.
           COPY DBIOMODNAME IN LIBRYMIS.
           COPY DBIOMODCA   IN LIBRYMIS.
           COPY STRTAREA    IN LIBRYMIS.
           COPY UT0151CA    IN LIBRYMIS.

       01  UT0250CA-CALL-AREA.
           COPY SYSPCALL    IN LIBRYMIS.

       01  PUAREA.
           03 WA-INPUT-PARAM-TABLE OCCURS 32 TIMES PIC X.
           03 FIELD-B                           PIC X(04).

       LINKAGE SECTION.
       01  LNK-REQUEST.
           03 LNK-REQ-ACCT-NO                   PIC X(16).
           03 LNK-REQ-BRANCH                    PIC X(05).
           03 LNK-REQ-DATE-BIN                  PIC 9(09) BINARY.
       01  LNK-RESPONSE.
           03 LNK-RESP-CODE                     PIC 9(03).
           03 LNK-RESP-MESSAGE                  PIC X(80).
           03 LNK-STATEMENT-LINE-COUNT          PIC 9(04).
           03 LNK-STATEMENT-ARRAY OCCURS 500 TIMES.
              05 LNK-REC-DATA                   PIC X(176).

       PROCEDURE DIVISION USING LNK-REQUEST, LNK-RESPONSE.

       0000-MAIN-PARA.
           INITIALIZE LNK-RESPONSE
           MOVE 200 TO LNK-RESP-CODE
           MOVE SPACES TO LNK-RESP-MESSAGE
           MOVE ZEROS TO LNK-STATEMENT-LINE-COUNT

           INITIALIZE WA-CO WB-CO P-IND WA-I WA-IND WA-SIGN[span_0](start_span)[span_0](end_span)
                      WA-S WA-W WW-B WA-FLAG[span_1](start_span)[span_1](end_span)
                      WA-PREV-ACT-NO[span_2](start_span)[span_2](end_span)
                      WA-TRAN-DATE1[span_3](start_span)[span_3](end_span)
                      WA-TEMP-BAL-Z WA-TEMP-BAL WA-TRAN-AMOUNT WB-SIGN[span_4](start_span)[span_4](end_span)
                      WB-IND WA-STMNT-NO[span_5](start_span)[span_5](end_span)
                      WS-EOF[span_6](start_span)[span_6](end_span)
           MOVE ZEROS  TO WS-TALLY[span_7](start_span)[span_7](end_span)
                          WA-TRAN-CODE[span_8](start_span)[span_8](end_span)
                          EXIT-TRAN[span_9](start_span)[span_9](end_span)
                          WA-DATE WA-BIT WA-JRNL[span_10](start_span)[span_10](end_span)
                          WA-OPEN-BAL WS-BGL-BALANCE[span_11](start_span)[span_11](end_span)
                          FLAG-62 WE-C WE-D WE-A WE-B[span_12](start_span)[span_12](end_span)
                          WA-AMT1[span_13](start_span)[span_13](end_span)
                          WA-BAL FLAG1 WA-OPEN-BAL-TEM[span_14](start_span)[span_14](end_span)
                          WA-TEMP-AMNT WA-CLOS-AMNT1 WA-CLOS-AMNT[span_15](start_span)[span_15](end_span)
           MOVE SPACES TO DEAL-DT WG-NARR[span_16](start_span)[span_16](end_span)
                          SQ-GLDM-KEY WS-GLDM-KEY[span_17](start_span)[span_17](end_span)
                          WA-TRAN-NO WA-BIC-CODE WA-CORR-REF[span_18](start_span)[span_18](end_span)
                          WA-REC0 WA-REC1 WA-REC2 WA-REC3[span_19](start_span)[span_19](end_span)
                          WA-PART-BR-REF WA-PART-CORR-REF[span_20](start_span)[span_20](end_span)
                          WA-MFX-SR-NO[span_21](start_span)[span_21](end_span)
                          WC-SIGN WC-IND[span_22](start_span)[span_22](end_span)
                          WA-DEAL-DATE[span_23](start_span)[span_23](end_span)
                          WS-ACT-NO WA-SR-NO WA-BRANCH WA-BR-REF[span_24](start_span)[span_24](end_span)
                          WS-CURR[span_25](start_span)[span_25](end_span)

           MOVE LNK-REQ-ACCT-NO  TO WS-ACT-NO
           MOVE LNK-REQ-BRANCH   TO WA-BRANCH
           MOVE LNK-REQ-DATE-BIN TO WA-DATE

           PERFORM A250-JULIAN THRU A250-EXIT[span_26](start_span)[span_26](end_span)
           PERFORM A010-FETCH-TARGET-ACCOUNT THRU A010-EXIT
           IF SQLCODE NOT = ZEROS
               MOVE 404 TO LNK-RESP-CODE
               MOVE "ACCOUNT NOT FOUND OR INVALID FOR STATEMENT"
                 TO LNK-RESP-MESSAGE
               GOBACK
           END-IF

           PERFORM G100-GECT-DETAILS THRU G100-EXIT[span_27](start_span)[span_27](end_span)

           EXEC SQL CLOSE GETDETL1 END-EXEC[span_28](start_span)[span_28](end_span)
           EXEC SQL CLOSE GETDETL3 END-EXEC[span_29](start_span)[span_29](end_span)
           EXEC SQL CLOSE GETDETL4 END-EXEC[span_30](start_span)[span_30](end_span)

           GOBACK.

       A010-FETCH-TARGET-ACCOUNT.
           MOVE SPACES TO WA-BIC-CODE WS-FD-CODE WS-CURR
           EXEC SQL
               SELECT ACCT_NO,
                      CURRENCY,
                      FD_CODE,
                      BIC_CODE
               INTO  :WS-ACT-NO,
                     :WS-CURR,
                     :WS-FD-CODE,
                     :WA-BIC-CODE
               FROM   FXAT
               WHERE  INST_NO = '003'
                 AND  BRANCH  = :WA-BRANCH
                 AND  ACCT_NO = :WS-ACT-NO
                 AND  ID_CODE = 'NM[span_31](start_span)'[span_31](end_span)
           END-EXEC.
       A010-EXIT.
           EXIT.

       G100-GECT-DETAILS.
           PERFORM D400-FORMAT-SWIFT THRU D400-EXIT[span_32](start_span)[span_32](end_span)
           MOVE WS-ACT-NO TO WA-PREV-ACT-NO[span_33](start_span)[span_33](end_span)
           MOVE WA-DATE TO UT0020-BINARY-DATE[span_34](start_span)[span_34](end_span)
           PERFORM Y010-UT0020-PARA THRU Y010-EXIT[span_35](start_span)[span_35](end_span)
           MOVE UT0020-DATE-DDMMCCYY TO WA-TRAN-DATE1[span_36](start_span)[span_36](end_span)
           MOVE "N" TO WS-EOF[span_37](start_span)[span_37](end_span)
           PERFORM T200-GET-GECT-AMT THRU T200-EXIT[span_38](start_span)[span_38](end_span)
           PERFORM T300-FETCH-GECT-AMT THRU T300-EXIT[span_39](start_span)[span_39](end_span)
                   UNTIL WS-EOF = 'Y'.[span_40](start_span)[span_40](end_span)
       G100-EXIT.
           EXIT.

       D400-FORMAT-SWIFT.
           MOVE 1 TO WA-INDEX.[span_41](start_span)[span_41](end_span)
       LOOP-1.
           IF WA-INDEX < 13[span_42](start_span)[span_42](end_span)
              IF WA-BIC-CODE(WA-INDEX:1) = SPACES[span_43](start_span)[span_43](end_span)
                 MOVE "X" TO WA-BIC-CODE(WA-INDEX:1)[span_44](start_span)[span_44](end_span)
                 ADD 1 TO WA-INDEX[span_45](start_span)[span_45](end_span)
                 GO TO LOOP-1[span_46](start_span)[span_46](end_span)
              ELSE
                 ADD 1 TO WA-INDEX[span_47](start_span)[span_47](end_span)
                 GO TO LOOP-1[span_48](start_span)[span_48](end_span)
              END-IF
           END-IF.[span_49](start_span)[span_49](end_span)
       D400-EXIT.
           EXIT.

       A250-JULIAN.
           PERFORM A260-GET-DATE THRU A260-EXIT[span_50](start_span)[span_50](end_span)
           MOVE '01'          TO UT0030-DATE-DD[span_51](start_span)[span_51](end_span)
           MOVE '01'          TO UT0030-DATE-MM[span_52](start_span)[span_52](end_span)
           MOVE WA-TRAN-CC    TO UT0030-DATE-CC[span_53](start_span)[span_53](end_span)
           MOVE WA-TRAN-YY    TO UT0030-DATE-YY[span_54](start_span)[span_54](end_span)
           MOVE 1             TO UT0030-FUNCTION[span_55](start_span)[span_55](end_span)
           CALL "UT0030" USING UT0030-FUNCTION[span_56](start_span)[span_56](end_span)
                               UT0030-DATE-AREA[span_57](start_span)[span_57](end_span)
                               UT0030-BINARY-DATE[span_58](start_span)[span_58](end_span)
           COMPUTE WA-STMNT-NO = WA-DATE - UT0030-BINARY-DATE.[span_59](start_span)[span_59](end_span)
       A250-EXIT.
           EXIT.

       A260-GET-DATE.
           MOVE WA-DATE TO UT0020-BINARY-DATE[span_60](start_span)[span_60](end_span)
           MOVE 1 TO UT0020-FUNCTION[span_61](start_span)[span_61](end_span)
           CALL "UT0020" USING UT0020-FUNCTION[span_62](start_span)[span_62](end_span)
                               UT0020-DATE-AREA[span_63](start_span)[span_63](end_span)
                               UT0020-BINARY-DATE[span_64](start_span)[span_64](end_span)
           MOVE UT0020-DATE-DD   TO WA-TRAN-DD[span_65](start_span)[span_65](end_span)
           MOVE UT0020-DATE-MM   TO WA-TRAN-MM[span_66](start_span)[span_66](end_span)
           MOVE UT0020-DATE-CC   TO WA-TRAN-CC[span_67](start_span)[span_67](end_span)
           MOVE UT0020-DATE-YY   TO WA-TRAN-YY.[span_68](start_span)[span_68](end_span)
       A260-EXIT.
           EXIT.

       T200-GET-GECT-AMT.
           EXEC SQL DECLARE GETDETL3 CURSOR FOR[span_69](start_span)[span_69](end_span)
                SELECT /*+ INDEX(GECT GECTUK_04) */[span_70](start_span)[span_70](end_span)
                       baseconv.convdata (var_area, 31,8,3) "AMOUNT",[span_71](start_span)[span_71](end_span)
                       baseconv.convdata (var_area, 73,8,3) "BALANCE",[span_72](start_span)[span_72](end_span)
                       substr(var_area,41,1) "CORRELATION BIT",[span_73](start_span)[span_73](end_span)
                       baseconv.convdata (var_area, 19,4) "TRANCODE",[span_74](start_span)[span_74](end_span)
                       JRNL_NO[span_75](start_span)[span_75](end_span)
                FROM GECT[span_76](start_span)[span_76](end_span)
                WHERE (INST_NO = '003'      AND[span_77](start_span)[span_77](end_span)
                       ACCT_NO = :WS-ACT-NO AND[span_78](start_span)[span_78](end_span)
                       TRAN_TYPE = '01'     AND[span_79](start_span)[span_79](end_span)
                       TRAN_DATE = :WA-DATE)[span_80](start_span)[span_80](end_span)
                ORDER BY REC_NO DESC[span_81](start_span)[span_81](end_span)
           END-EXEC[span_82](start_span)[span_82](end_span)
           EXEC SQL OPEN GETDETL3 END-EXEC.[span_83](start_span)[span_83](end_span)
       T200-EXIT.
           EXIT.

       T300-FETCH-GECT-AMT.
           MOVE ZEROS TO WA-OPEN-BAL WA-BAL WA-AMT1[span_84](start_span)[span_84](end_span)
                         WA-BIT WA-TRAN-CODE[span_85](start_span)[span_85](end_span)
           MOVE ZEROS TO WA-JRNL[span_86](start_span)[span_86](end_span)
           EXEC SQL FETCH GETDETL3[span_87](start_span)[span_87](end_span)
                INTO    :WA-AMT1,[span_88](start_span)[span_88](end_span)
                        :WA-BAL,[span_89](start_span)[span_89](end_span)
                        :WA-BIT,[span_90](start_span)[span_90](end_span)
                        :WA-TRAN-CODE,[span_91](start_span)[span_91](end_span)
                        :WA-JRNL[span_92](start_span)[span_92](end_span)
           END-EXEC[span_93](start_span)[span_93](end_span)
           IF ( SQLCODE IN SQLCA = 1403 OR LESS THAN ZEROS )[span_94](start_span)[span_94](end_span)
              PERFORM A101-GENERATE-TAIL THRU A101-EXIT[span_95](start_span)[span_95](end_span)
              GO TO T300-EXIT[span_96](start_span)[span_96](end_span)
           END-IF[span_97](start_span)[span_97](end_span)
           IF WA-BIT = 1[span_98](start_span)[span_98](end_span)
              GO TO T300-EXIT[span_99](start_span)[span_99](end_span)
           END-IF[span_100](start_span)[span_100](end_span)

           MOVE WA-TRAN-CODE TO LINK-IN-TXCODE[span_101](start_span)[span_101](end_span)
           PERFORM Y200-SET-UP-EDIT-MASK THRU Y200-EXIT[span_102](start_span)[span_102](end_span)
           MOVE LINK-EDIT-TABLE TO STRT-AREA-EDIT-MASK[span_103](start_span)[span_103](end_span)
           MOVE LINK-POSTING-LEVEL TO STRT-AREA-POSTING-LEVEL[span_104](start_span)[span_104](end_span)
           MOVE STRT-AREA-PROCESS-BITS TO FIELD-B[span_105](start_span)[span_105](end_span)
           CALL "UT0022" USING PUAREA[span_106](start_span)[span_106](end_span)

           IF WA-INPUT-PARAM-TABLE(7) = 1[span_107](start_span)[span_107](end_span)
              GO TO T300-EXIT[span_108](start_span)[span_108](end_span)
           END-IF[span_109](start_span)[span_109](end_span)

           IF SQLCODE = ZEROS[span_110](start_span)[span_110](end_span)
              MOVE 'F' TO WA-FLAG[span_111](start_span)[span_111](end_span)
              COMPUTE WA-OPEN-BAL = WA-BAL - WA-AMT1[span_112](start_span)[span_112](end_span)
              PERFORM S200-GET-GECT THRU S200-EXIT[span_113](start_span)[span_113](end_span)
              PERFORM DO-PERFORM-TILL THRU DO-PERFORM-EXIT[span_114](start_span)[span_114](end_span)
           END-IF.[span_115](start_span)[span_115](end_span)
       T300-EXIT.
           EXIT.

       S200-GET-GECT.
           MOVE "N" TO WS-EOF[span_116](start_span)[span_116](end_span)
           EXEC SQL DECLARE GETDETL1 CURSOR FOR[span_117](start_span)[span_117](end_span)
           SELECT /*+ INDEX(GECT GECTUK_04) */[span_118](start_span)[span_118](end_span)
                  SUBSTR(var_area,13,9) "MFX REF NO",[span_119](start_span)[span_119](end_span)
                  SUBSTR(VAR_AREA,22,8) "DEAL DATE",[span_120](start_span)[span_120](end_span)
                  SUBSTR(VAR_AREA,30,5) "BRANCH",[span_121](start_span)[span_121](end_span)
                  SUBSTR(var_area,35,16) "BRANCH REFRENCE",[span_122](start_span)[span_122](end_span)
                  SUBSTR(var_area,56,8) "VALUE DATE[span_123](start_span)"[span_123](end_span)
           FROM   GECT[span_124](start_span)[span_124](end_span)
           WHERE (INST_NO   = '003'      AND[span_125](start_span)[span_125](end_span)
                  ACCT_NO   = :WS-ACT-NO AND[span_126](start_span)[span_126](end_span)
                  TRAN_TYPE = '85'       AND[span_127](start_span)[span_127](end_span)
                  TRAN_DATE = :WA-DATE   AND[span_128](start_span)[span_128](end_span)
                  JRNL_NO   = :WA-JRNL)[span_129](start_span)[span_129](end_span)
           END-EXEC[span_130](start_span)[span_130](end_span)
           EXEC SQL OPEN GETDETL1 END-EXEC.[span_131](start_span)[span_131](end_span)
       S200-EXIT.
           EXIT.

       S300-FETCH-GECT.
           MOVE SPACES TO WA-SR-NO[span_132](start_span)[span_132](end_span)
                          WA-DEAL-DATE[span_133](start_span)[span_133](end_span)
                          WA-BRANCH[span_134](start_span)[span_134](end_span)
                          WA-BR-REF[span_135](start_span)[span_135](end_span)
                          WA-VAL-DATE[span_136](start_span)[span_136](end_span)
           EXEC SQL FETCH GETDETL1[span_137](start_span)[span_137](end_span)
                    INTO  :WA-SR-NO,[span_138](start_span)[span_138](end_span)
                          :WA-DEAL-DATE,[span_139](start_span)[span_139](end_span)
                          :WA-BRANCH,[span_140](start_span)[span_140](end_span)
                          :WA-BR-REF,[span_141](start_span)[span_141](end_span)
                          :WA-VAL-DATE[span_142](start_span)[span_142](end_span)
           END-EXEC[span_143](start_span)[span_143](end_span)
           IF SQLCODE = 1403 OR LESS THAN ZEROS[span_144](start_span)[span_144](end_span)
              GO TO S300-EXIT[span_145](start_span)[span_145](end_span)
           END-IF[span_146](start_span)[span_146](end_span)

           IF SQLCODE = ZEROS[span_147](start_span)[span_147](end_span)
              MOVE WA-DATE TO UT0020-BINARY-DATE[span_148](start_span)[span_148](end_span)
              PERFORM Y010-UT0020-PARA THRU Y010-EXIT[span_149](start_span)[span_149](end_span)
              MOVE UT0020-DATE-DDMMCCYY TO WA-TRAN-DATE1[span_150](start_span)[span_150](end_span)
              MOVE WA-DEAL-DATE TO UT0030-DATE-DDMMCCYY[span_151](start_span)[span_151](end_span)
